<odoo>
    <record id="users_patch.view_users_form_inherit" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.user_patch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook//page[@name='preferences']" position="after">
                <page name="properties" string="Properties">
                    <group string="My Properties">
                        <field name="property_ids"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>