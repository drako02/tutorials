<odoo>
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name" width="15%" />
                <field name="postcode" width="15%" />
                <field name="bedrooms" width="10%" />
                <field name="expected_price" width="15%" />
                <field name="selling_price" width="15%" />
                <field name="date_availability" width="15%" />
                <field name="tag_ids" width="15%" />
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <sheet>
                    <!-- <widget name="web_ribbon" title="Archived" bg_color="bg-danger" /> -->
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1 class="mb8">
                            <field name="name" class="mb16" />
                        </h1>
                        <field name="active" invisible="1" />
                    </div>

                    <group>
                        <field class="mb8" name="tag_ids" widget="many2many_tags" />

                        <group>
                            <field name="postcode" />
                            <field name="expected_price" />
                        </group>

                        <group>
                            <field name="selling_price" />
                            <field name="date_availability" />
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" />

                                <group>
                                    <field name="bedrooms" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden" />
                                    <field name="living_area"/>
                                    <field name="garden_area" />
                                    <field name="garden_orientation" />
                                    <field name="state" />
                                    <field name="property_type_id" />
                                    <field name="tag_ids" />
                                    <field name="total_area" />
                                    <field name="best_price" />

                                </group>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="salesperson_id" />
                                    <field name="buyer_id" />
                                </group>
                            </page>
                            <page string="Offers">
                                <group>
                                    <field name="offer_ids" />
                                </group>
                            </page>
                        </notebook>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
                <separator />
                <filter string="Available" name="available"
                    domain="[('date_availability', '&lt;=', (context_today()))]" />
                <filter name="state"
                    domain="[ '|',('state', '=', 'new'), ('state', '=', 'offer_received')]" />
                <group>
                    <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode', 'residual_visible':True}" />
                </group>

            </search>
        </field>
    </record>

    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price" width="auto" />
                <field name="status" width="auto" />
                <field name="partner_id" width="auto" />
                <!-- <field name="property_id" width="25%" /> -->
            </list>
        </field>
    </record>

</odoo>