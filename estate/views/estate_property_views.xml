<odoo>
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties"
                decoration-success="(state == 'offer_received') or (state == 'offer_accepted')"
                decoration-bf="state == 'offer_accepted'"
                decoration-muted="state == 'sold'"
            >
                <field name="name" width="15%" />
                <field name="postcode" width="15%" />
                <field name="bedrooms" width="10%" />
                <field name="expected_price" width="15%" />
                <field name="selling_price" width="15%" />
                <field name="date_availability" width="15%" optional="hide" />
                <field name="tag_ids" width="15%" />
                <!-- <field name="state" width="1%" invisible="true"> -->

            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <header>
                    <button name="set_sold" type="object" string="Sold"
                        invisible="state == 'sold' or state == 'cancelled'" />
                    <button name="set_cancelled" type="object" string="Cancel"
                        invisible="state == 'cancelled' or state == 'sold'" />
                    <field name="state" widget="statusbar" />

                </header>
                <sheet>
                    <!-- <widget name="web_ribbon" title="Archived" bg_color="bg-danger" /> -->
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1 class="mb8">
                            <field name="name" class="mb16" />
                        </h1>
                        <field name="active" invisible="1" />
                    </div>

                    <group>
                        <field class="mb8" name="tag_ids" widget="many2many_tags"
                            options="{'color_field': 'color'}" />

                        <group>
                            <field name="postcode" />
                            <field name="expected_price" />
                            <!-- <field name="state" widget="statusbar" /> -->
                        </group>

                        <group>
                            <field name="selling_price" />
                            <field name="date_availability" />
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" />

                                <group>
                                    <field name="bedrooms" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden" />
                                    <field name="living_area" />
                                    <field name="garden_area" invisible="not garden" />
                                    <field name="garden_orientation" />
                                    <field name="property_type_id" options="{'no_create': true}" />
                                    <field name="tag_ids" />
                                    <field name="total_area" />
                                    <field name="best_price" />

                                </group>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="salesperson_id" />
                                    <field name="buyer_id" />
                                </group>
                            </page>
                            <page string="Offers">
                                <group>
                                    <field name="offer_ids"
                                        readonly="state=='offer_accepted' or state=='sold' or state=='cancelled'" />
                                </group>
                            </page>
                        </notebook>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="living_area" filter_domain="[('living_area', '>=', self)]" />
                <field name="date_availability" />
                <separator />
                <filter string="Available" name="available"
                    domain="[('date_availability', '&lt;=', (context_today()))]" />
                <filter name="state" string="State"
                    domain="[ '|',('state', '=', 'new'), ('state', '=', 'offer_received')]" />
                <group>
                    <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode', 'residual_visible':True}" />
                </group>

            </search>
        </field>
    </record>

    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status == 'refused'"
                decoration-success="status == 'accepted'">
                <field name="price" width="auto" />
                <field name="status" width="auto" invisible="true" />
                <field name="partner_id" width="auto" />
                <field name="validity" />
                <field name="date_deadline" />
                <button name="accept_offer" string="" title="accept" type="object" icon="fa-check"
                    invisible="status == 'accepted' or status == 'refused'" />
                <button name="refuse_offer" string="" title="refuse" type="object" icon="fa-times"
                    invisible="status == 'accepted' or status == 'refused'" />
                <!-- <field name="property_id" width="25%" /> -->
            </list>
        </field>
    </record>

    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="price" />
                    <field name="status" />
                    <field name="partner_id" />
                    <field name="validity" />
                    <field name="date_deadline" />
                </group>
            </form>
        </field>
    </record>

    <record id="estate_property_type_form_view" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>

                <h1 class="mb16">
                    <field name="name" />
                </h1>

                <notebook>
                    <page string="Properties">
                        <field name="property_ids">
                            <list>
                                <field name="name" string="Title" />
                                <field name="expected_price" />
                                <field name="state" string="Status" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="estate_property_type_list_view" model="ir.ui.view">
        <field name="name">estate.property.type.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />

            </list>
        </field>
    </record>

    <record id="estate_property_tag_list_view" model="ir.ui.view">
        <field name="name">estate.property.tag.list</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="color" />
            </list>

        </field>
    </record>

</odoo>